{
  "name": "plugin-keeperhub",
  "description": "KeeperHub workflow automation for ElizaOS — manage workflows, DeFi protocols, on-chain execution, and AI-generated automations via KeeperHub MCP",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/src/index.d.ts",
  "packageType": "plugin",
  "platform": "node",
  "license": "MIT",
  "author": "KeeperHub",
  "keywords": [
    "plugin",
    "elizaos",
    "elizaos-plugin",
    "eliza-plugin",
    "keeperhub",
    "workflow",
    "automation",
    "web3",
    "defi",
    "smart-contracts"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "images",
    "README.md",
    "package.json"
  ],
  "peerDependencies": {
    "@elizaos/core": ">=1.0.0"
  },
  "dependencies": {
    "@keeperhub/mcp": "^0.1.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@elizaos/core": "^1.7.2",
    "typescript": "^5.9.3"
  },
  "repository": "github:Bleyle823/Keepers-Eliza-Plugin",
  "scripts": {
    "build": "bun run build.ts",
    "build:watch": "bun run build.ts --watch",
    "dev": "elizaos dev",
    "start": "elizaos start",
    "test": "bun test",
    "format": "prettier --write ./src"
  },
  "publishConfig": {
    "access": "public"
  },
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0",
    "pluginParameters": {
      "KH_API_KEY": {
        "type": "string",
        "description": "KeeperHub organization API key (starts with kh_)"
      }
    }
  }
}
