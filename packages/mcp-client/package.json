{
  "name": "@keeperhub/mcp-client",
  "version": "1.0.0",
  "description": "Official KeeperHub MCP HTTP transport client — session bootstrap, tools/call, 401/404 re-init, API key helpers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "license": "MIT",
  "author": "KeeperHub",
  "keywords": ["keeperhub", "mcp", "model-context-protocol", "workflow", "web3"],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "bun-types": "^1.2.0",
    "typescript": "^5.9.3"
  }
}
